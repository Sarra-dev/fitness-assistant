# Copy this file to ".env" and fill in your values.
# Get a free Gemini API key at https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty to run in offline mode (rule-based answers).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend origins allowed to call this API (comma-separated, no spaces needed)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Retrieval / conversation settings
TOP_K=4
MAX_HISTORY=8
REQUEST_TIMEOUT=30
